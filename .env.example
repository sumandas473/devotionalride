# Database Configuration (Hostinger MySQL 8 / MariaDB)
DATABASE_URL="mysql://u123456789_dr_user:StrongDbPassword123!@127.0.0.1:3306/u123456789_devotionalride"
DATABASE_MIGRATION_URL="mysql://u123456789_dr_admin:AdminMigrationPassword123!@127.0.0.1:3306/u123456789_devotionalride"

# Security & Sessions (Generate using: openssl rand -base64 48)
SESSION_SECRET="sample_session_secret_change_in_production_min_48_chars_long_entropy_string"
ENCRYPTION_KEY="sample_32_byte_hex_key_for_aes256gcm_totp_secret_encryption_at_rest"
CRON_SECRET="sample_secret_key_used_to_authenticate_scheduled_cron_jobs"

# Super Admin Initial Onboarding Credential
SUPER_ADMIN_EMAIL="admin@devotionalride.com"
SUPER_ADMIN_INITIAL_PASSWORD="TemporaryStrongPassword#2026!"

# Razorpay Payment Gateway (Test keys for staging, live keys for production)
RAZORPAY_KEY_ID="rzp_test_YourSampleRazorpayKeyId"
RAZORPAY_KEY_SECRET="YourSampleRazorpayKeySecret"
RAZORPAY_WEBHOOK_SECRET="YourSampleRazorpayWebhookSecret"

# Shiprocket Courier Aggregator
SHIPROCKET_EMAIL="logistics@devotionalride.com"
SHIPROCKET_PASSWORD="YourSampleShiprocketPassword"

# Hostinger SMTP Mailer
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="notifications@devotionalride.com"
SMTP_PASS="YourSampleHostingerEmailPassword"
SMTP_FROM_NAME="Devotional Ride Support"
SMTP_FROM_EMAIL="support@devotionalride.com"

# Site Public URLs
NEXT_PUBLIC_SITE_URL="https://devotionalride.com"

# Storage Directories
STORAGE_DIR="D:/devotionalride/storage"
INVOICE_DIR="D:/devotionalride/storage/invoices"

# Bot Protection (Cloudflare Turnstile or Google reCAPTCHA v3)
NEXT_PUBLIC_CAPTCHA_SITE_KEY="0x4AAAAAAAxSampleTurnstileSiteKey"
CAPTCHA_SECRET_KEY="0x4AAAAAAAxSampleTurnstileSecretKey"
